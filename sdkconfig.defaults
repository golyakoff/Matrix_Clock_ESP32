# Common defaults for all build variants (see variants/*.defaults and tools/build.sh)

# Arduino as an ESP-IDF component: setup()/loop() run as before
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
# loop() polls without blocking and never lets the idle task of CPU 1 run: don't watch it, as in the
# Arduino core's own sdkconfig (otherwise the task watchdog reports loopTask every 5 s)
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# A plain `idf.py build` (or the VS Code ESP-IDF extension) builds for a 4MB board; tools/build.sh
# picks the flash size, partition table, optimization and logs of each variant
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/4MB.csv"

# A new firmware that fails to start is rolled back by the bootloader. The Arduino core marks the
# running firmware valid right after start (initArduino()).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# BLE: NimBLE peripheral, one connection. The host task runs the GATT write callbacks, and the
# OTA control ones (ota_end()) need more than the default 4 KB of stack.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=515
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Phones pair for the encrypted WiFi settings write (ble.cpp): keep the bonds across reboots, or the
# phone's bond would no longer match after one
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Compile only the Arduino libraries the clock uses (BLE is esp-nimble-cpp, not Arduino's BLE)
CONFIG_ARDUINO_SELECTIVE_COMPILATION=y
CONFIG_ARDUINO_SELECTIVE_ArduinoOTA=n
CONFIG_ARDUINO_SELECTIVE_AsyncUDP=n
CONFIG_ARDUINO_SELECTIVE_BLE=n
CONFIG_ARDUINO_SELECTIVE_BluetoothSerial=n
CONFIG_ARDUINO_SELECTIVE_DNSServer=n
CONFIG_ARDUINO_SELECTIVE_EEPROM=n
CONFIG_ARDUINO_SELECTIVE_ESP_SR=n
CONFIG_ARDUINO_SELECTIVE_ESP_Video=n
CONFIG_ARDUINO_SELECTIVE_ESPmDNS=n
CONFIG_ARDUINO_SELECTIVE_Ethernet=n
CONFIG_ARDUINO_SELECTIVE_FFat=n
CONFIG_ARDUINO_SELECTIVE_FS=y
CONFIG_ARDUINO_SELECTIVE_HTTPClient=n
CONFIG_ARDUINO_SELECTIVE_Hash=y
CONFIG_ARDUINO_SELECTIVE_Insights=n
CONFIG_ARDUINO_SELECTIVE_LittleFS=n
CONFIG_ARDUINO_SELECTIVE_Matter=n
CONFIG_ARDUINO_SELECTIVE_NetBIOS=n
CONFIG_ARDUINO_SELECTIVE_Network=n
CONFIG_ARDUINO_SELECTIVE_NetworkClientSecure=n
CONFIG_ARDUINO_SELECTIVE_OpenThread=n
CONFIG_ARDUINO_SELECTIVE_PPP=n
CONFIG_ARDUINO_SELECTIVE_Preferences=y
CONFIG_ARDUINO_SELECTIVE_RainMaker=n
CONFIG_ARDUINO_SELECTIVE_SD=n
CONFIG_ARDUINO_SELECTIVE_SD_MMC=n
CONFIG_ARDUINO_SELECTIVE_SPI=y
CONFIG_ARDUINO_SELECTIVE_SPIFFS=n
CONFIG_ARDUINO_SELECTIVE_SimpleBLE=n
CONFIG_ARDUINO_SELECTIVE_Ticker=n
CONFIG_ARDUINO_SELECTIVE_Update=y
CONFIG_ARDUINO_SELECTIVE_WebServer=n
CONFIG_ARDUINO_SELECTIVE_WiFi=n
CONFIG_ARDUINO_SELECTIVE_WiFiProv=n
CONFIG_ARDUINO_SELECTIVE_Wire=y
CONFIG_ARDUINO_SELECTIVE_Zigbee=n

# WiFi (time sync and updates from the internet) together with BLE
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# WiFi + BLE + coexistence overflow ESP32's 128 KB IRAM: trade a little WiFi throughput for room
# (the clock only syncs time and downloads an update now and then)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n

# Room in the 4MB build's 1.875 MB app slot (WiFi + TLS + BLE + the animations): only what the clock
# uses. It is a WiFi client that talks HTTPS to GitHub and nothing else.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
