CONFIG_MC_FLASH_MB=4
CONFIG_MC_BUILD_VARIANT="release_4mb"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/4MB.csv"
# Optimized for size; the display code is built with -O2 anyway (main/CMakeLists.txt, components/)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
