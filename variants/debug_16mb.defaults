# Verbose serial logs on a 16MB board, for local runs and debugging; not published in releases.
# Optimized for size like the release builds; the display code stays -O2.
CONFIG_MC_FLASH_MB=16
CONFIG_MC_BUILD_VARIANT="debug_16mb"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/16MB.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
