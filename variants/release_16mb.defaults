CONFIG_MC_FLASH_MB=16
CONFIG_MC_BUILD_VARIANT="release_16mb"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/16MB.csv"
# Optimized for size; the display code is built with -O2 anyway (main/CMakeLists.txt, components/)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
